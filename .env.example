# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=

# TiDB Cloud (Connect dialog in the TiDB Cloud console)
TIDB_HOST=
TIDB_PORT=
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
# Optional. Path to a CA certificate file, e.g. certs/isrgrootx1.pem.
# Leave empty to use the certificates from the certifi package (no file needed).
TIDB_CA_PATH=

# Optional settings (these are the defaults)
# MAX_UPLOAD_MB=30
# GEMINI_TIMEOUT_SECONDS=180
# Web addresses allowed to call the API from a browser (the Vite dev server)
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
